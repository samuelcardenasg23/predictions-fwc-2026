generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
}

enum MatchStage {
  GROUP
  R32
  R16
  QF
  SF
  THIRD_PLACE
  FINAL
}

enum MatchPhase {
  GROUP_STAGE
  KNOCKOUT
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  passwordHash          String
  name                  String
  role                  Role      @default(USER)
  createdAt             DateTime  @default(now())
  groupStageLockedAt    DateTime?
  groupStageEntryAt     DateTime?

  predictions  Prediction[]
  stageLocks   UserStageLock[]
}

model Match {
  id            String      @id @default(cuid())
  externalId    Int?        @unique
  homeTeam      String
  awayTeam      String
  scheduledAt   DateTime
  homeScore     Int?
  awayScore     Int?
  status        MatchStatus @default(SCHEDULED)
  stage         MatchStage
  phase         MatchPhase
  groupName        String?
  matchOrder       Int?
  excludedFromPool Boolean @default(false)

  predictions Prediction[]
}

model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model UserStageLock {
  id       String     @id @default(cuid())
  userId   String
  stage    MatchStage
  lockedAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, stage])
}

model Prediction {
  id            String   @id @default(cuid())
  userId        String
  matchId       String
  homeScore     Int
  awayScore     Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  match Match @relation(fields: [matchId], references: [id])

  @@unique([userId, matchId])
}
